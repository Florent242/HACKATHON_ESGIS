{
  "name": "hackathon_esgis",
  "version": "1.0.0",
  "description": "Ce projet a pour but de créer un **site de rencontre** dynamique. Il permet aux utilisateurs de s'inscrire, de se connecter, et de trouver des correspondances selon différents critères. Le backend utilise PHP, et le frontend est géré via des fichiers HTML/PHP dynamiques.",
  "main": "home.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx tailwindcss -i ./public/css/styles/global.css -o ./public/css/dist/output.css --watch",
    "postcss": "postcss ./public/css/styles/global.css -o ./public/css/dist/output.css --watch",
    "build:css": "postcss ./public/css/styles/global.css -o ./public/css/dist/output.css --env production",
    "lucide:build": "npx lucide build frontend/icons",
    "lucide:update": "npm update @lucide/icons && npm run lucide:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Florent242/HACKATHON_ESGIS.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Florent242/HACKATHON_ESGIS/issues"
  },
  "homepage": "https://github.com/Florent242/HACKATHON_ESGIS#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.0.8",
    "install": "^0.13.0",
    "jquery": "^3.7.1",
    "lucide": "^0.487.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^4.0.15"
  }
}
