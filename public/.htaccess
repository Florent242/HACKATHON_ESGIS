# 🔹 Active la réécriture d'URL
RewriteEngine On
RewriteBase /HACKATHON_ESGIS/public/

# 🔹 Rediriger toutes les requêtes API vers backend/api.php
RewriteCond %{REQUEST_URI} ^/HACKATHON_ESGIS/public/api/ [NC]
RewriteRule ^api/(.*)$ ../backend/api.php [QSA,L]

# 🔹 Ne pas réécrire les fichiers et dossiers existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 🔹 Rediriger toutes les autres requêtes vers index.php (pour le frontend)
RewriteRule ^(.*)$ index.php [QSA,L]