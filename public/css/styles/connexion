:root {
    --background: #030B20;
    --card-bg: linear-gradient(135deg, #030B20 0%, #030F2A 100%);
    --card-hover: #1E293B;
    --blue: #3B82F6;
    --text: #FFFFFF;
    --text-secondary: #94A3B8;
    --border: #1E293B;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: var(--background);
    color: var(--text);
    line-height: 1.5;
}
.auth-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}

.auth-card {
    background-color: #0D1117;
    border: 1px solid #1a1d2d;
    border-radius: 0.5rem;
    width: 100%;
    max-width: 400px;
    overflow: hidden;
}

.auth-tabs {
    display: flex;
    border-bottom: 1px solid #1a1d2d;
}

.auth-tab {
    flex: 1;
    padding: 1rem;
    text-align: center;
    text-decoration: none;
    color: #94a3b8;
    background: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
}


/* Survol des onglets, même quand ils ne sont pas actifs */
.auth-tab:hover {
    color: white;
    background-color: #0D1117;
    border-bottom: 2px solid #3B82F6;
    opacity: 1;
}


.auth-tab.active{
    color: white;
    background-color: #0D1117;
    border-bottom: 2px solid #3B82F6;
}


.auth-form {
    padding: 2rem;
}

.auth-form h1 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
}

.auth-form p {
    color: #94a3b8;
    margin-bottom: 2rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: #e2e8f0;
}

.form-group input {
    width: 100%;
    padding: 0.75rem;
    background-color: #0A0C14;
    border: 1px solid #1a1d2d;
    border-radius: 0.375rem;
    color: white;
    font-size: 1rem;
}

.form-group input:focus {
    outline: none;
    border-color: #3B82F6;
}

.submit-btn {
    width: 100%;
    padding: 0.75rem;
    background-color: #3B82F6;
    color:  #031a4b;
    border: none;
    border-radius: 0.375rem;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.2s;
}

.submit-btn:hover {
    background-color: #2563eb;
}